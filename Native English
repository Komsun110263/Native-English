<script>
const DAYS = ['อาทิตย์','จันทร์','อังคาร','พุธ','พฤหัสบดี','ศุกร์','เสาร์'];
const LIVE = location.protocol === 'http:' || location.protocol === 'https:';
const $ = id => document.getElementById(id);

const digits = s => String(s ?? '').replace(/\D/g, '');
function fmtPhone(raw){
  const d = digits(raw).slice(0,10);
  if (d.length <= 3) return d;
  if (d.length <= 6) return d.slice(0,3)+'-'+d.slice(3);
  return d.slice(0,3)+'-'+d.slice(3,6)+'-'+d.slice(6);
}
const validPhone = s => /^0\d{8,9}$/.test(digits(s));
function thaiDate(d){
  const x = new Date(d+'T00:00:00');
  return `${DAYS[x.getDay()]}ที่ ${x.getDate()}/${x.getMonth()+1}/${x.getFullYear()+543}`;
}
const esc = s => String(s ?? '').replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
function say(el, text, ok){
  el.innerHTML = text ? `<div class="msg ${ok?'ok':'err'}">${esc(text)}</div>` : '';
  if (text) el.scrollIntoView({behavior:'smooth', block:'nearest'});
}

/* ══════════ โหมดจำลองเมื่อเปิดดูในเครื่อง ══════════ */
const LS = {
  key:'libda_db_v1',
  read(){
    const raw = localStorage.getItem(this.key);
    if (raw) return JSON.parse(raw);
    const day = n => { const d = new Date(); d.setDate(d.getDate()+n); return d.toISOString().slice(0,10); };
    const seed = {
      slots:[
        {id:1,date:day(2),start_time:'16:00',end_time:'17:30',subject:'Phonics',teacher:'Kru John',capacity:6,status:'open',note:'ห้อง A'},
        {id:2,date:day(3),start_time:'10:00',end_time:'11:30',subject:'Reading',teacher:'Kru Anna',capacity:6,status:'open',note:''}
      ],
      bookings:[],
      settings:{contact_phone:'081-234-5678',contact_label:'สอบถามเพิ่มเติม / นัดเวลาพิเศษ',line_id:'@libdaenglish'},
      seq:{slot:3, booking:1}
    };
    this.write(seed); return seed;
  },
  write(d){ localStorage.setItem(this.key, JSON.stringify(d)); }
};
const DemoDB = {
  async settings(){ const d=LS.read(); return {contactPhone:d.settings.contact_phone,contactLabel:d.settings.contact_label,lineId:d.settings.line_id}; },
  async saveSettings(c){ const d=LS.read(); d.settings={contact_phone:fmtPhone(c.contactPhone),contact_label:c.contactLabel,line_id:c.lineId}; LS.write(d); },
  async openSlots(){ const d=LS.read(); const today=new Date().toISOString().slice(0,10);
    return d.slots.filter(s=>s.status==='open'&&s.date>=today)
      .map(s=>({...s,booked:d.bookings.filter(b=>b.slot_id===s.id&&b.status==='confirmed').length}))
      .filter(s=>s.booked<s.capacity).sort((a,b)=>(a.date+a.start_time).localeCompare(b.date+b.start_time)); },
  async book(p){ const d=LS.read();
    const s=d.slots.find(x=>x.id===p.slotId);
    if(!s) throw new Error('ไม่พบรอบเรียนนี้');
    const n=d.bookings.filter(b=>b.slot_id===s.id&&b.status==='confirmed').length;
    if(n>=s.capacity) throw new Error('รอบนี้เต็มแล้ว');
    const id=d.seq.booking++;
    d.bookings.push({id,slot_id:s.id,...p,status:'confirmed',created_at:new Date().toISOString()});
    LS.write(d); return 'B'+String(id).padStart(4,'0'); },
  async login(_,pw){ if(pw!=='Libda@2026') throw new Error('รหัสผ่านไม่ถูกต้อง'); sessionStorage.setItem('libda_admin','1'); },
  async logout(){ sessionStorage.removeItem('libda_admin'); },
  async isAdmin(){ return sessionStorage.getItem('libda_admin')==='1'; },
  async allSlots(){ const d=LS.read(); return d.slots.map(s=>({...s,booked:d.bookings.filter(b=>b.slot_id===s.id&&b.status==='confirmed').length})); },
  async saveSlot(s){ const d=LS.read();
    if(!s.id){ d.slots.push({...s,id:d.seq.slot++}); LS.write(d); return; }
    const i=d.slots.findIndex(x=>x.id===s.id); d.slots[i]={...d.slots[i],...s}; LS.write(d); },
  async delSlot(id){ const d=LS.read(); d.slots=d.slots.filter(s=>s.id!==id); LS.write(d); },
  async allBookings(){ const d=LS.read();
    return d.bookings.filter(b=>b.status==='confirmed').map(b=>{
      const s=d.slots.find(x=>x.id===b.slot_id)||{};
      return {...b,date:s.date,start_time:s.start_time,end_time:s.end_time,subject:s.subject};
    }); },
  async cancelBooking(id){ const d=LS.read(); const b=d.bookings.find(x=>x.id===id); if(b) b.status='cancelled'; LS.write(d); }
};

/* ══════════ ชั้นข้อมูล : Cloudflare API ══════════ */
async function api(path, opt = {}) {
  const res = await fetch('/api/' + path, {
    credentials: 'same-origin',
    headers: opt.body ? { 'Content-Type': 'application/json' } : {},
    ...opt,
  });
  const ct = res.headers.get('Content-Type') || '';
  const data = ct.includes('json') ? await res.json() : null;
  if (!res.ok) throw new Error((data && data.error) || 'เชื่อมต่อไม่สำเร็จ');
  return data;
}
const LiveDB = {
  settings:      () => api('settings'),
  saveSettings:  c  => api('settings', { method:'PUT', body: JSON.stringify(c) }),
  openSlots:     () => api('slots'),
  book:          async p => (await api('bookings', { method:'POST', body: JSON.stringify(p) })).bookingCode,
  login:         (_e, pw) => api('login', { method:'POST', body: JSON.stringify({ password: pw }) }),
  logout:        () => api('logout', { method:'POST' }),
  isAdmin:       async () => { try { return (await api('me')).admin; } catch { return false; } },
  allSlots:      () => api('admin/slots'),
  saveSlot:      s  => api('admin/slots', { method:'POST', body: JSON.stringify(s) }),
  delSlot:       id => api('admin/slots?id=' + id, { method:'DELETE' }),
  allBookings:   () => api('admin/bookings'),
  cancelBooking: id => api('admin/bookings?id=' + id, { method:'DELETE' }),
};

const DB = LIVE ? LiveDB : DemoDB;
if (!LIVE) { $('demoBar').classList.remove('hide'); }

/* ══════════ ควบคุมหน้าจอง ══════════ */
let picked = null;
$('phone').addEventListener('input', e => e.target.value = fmtPhone(e.target.value));
$('cfgPhone').addEventListener('input', e => e.target.value = fmtPhone(e.target.value));

async function loadSlots(){
  const area = $('slotArea');
  try{
    const list = await DB.openSlots();
    if(!list.length){
      area.innerHTML = '<p style="background:#f7fafd;border-radius:12px;padding:20px;text-align:center;color:#8aa3bd">ยังไม่มีรอบเรียนเปิดให้จองในขณะนี้</p>';
      return;
    }
    const byDate = {};
    list.forEach(s => (byDate[s.date] ||= []).push(s));
    area.innerHTML = Object.entries(byDate).map(([d,arr]) => `
      <div class="dayhead">${thaiDate(d)}</div>
      <div class="slots">${arr.map(s=>{
        const left = s.capacity - s.booked;
        return `<button type="button" class="slot${picked===s.id?' on':''}" data-id="${s.id}">
          <div class="t">
            <span class="time">${esc(s.start_time)}–${esc(s.end_time)}</span>
            <span class="pill${left<=2?' low':''}">ว่าง ${left}/${s.capacity}</span>
          </div>
          <div class="sub">${esc(s.subject)} — ${esc(s.teacher)}${s.note?' • '+esc(s.note):''}</div>
        </button>`;
      }).join('')}</div>`).join('');

    area.querySelectorAll('.slot').forEach(b => b.onclick = () => {
      picked = Number(b.dataset.id);
      area.querySelectorAll('.slot').forEach(x => x.classList.remove('on'));
      b.classList.add('on');
      syncBtn();
    });
    if (picked && !list.some(s => s.id === picked)) picked = null;
    syncBtn();
  }catch(e){ area.innerHTML = `<div class="msg err">โหลดรอบเรียนไม่สำเร็จ: ${esc(e.message)}</div>`; }
}

function syncBtn(){
  $('submitBtn').disabled = !picked;
  $('submitBtn').textContent = picked ? 'ยืนยันการจอง' : 'กรุณาเลือกรอบเรียนก่อน';
}

$('submitBtn').onclick = async () => {
  const p = {
    slotId: picked,
    firstName: $('firstName').value.trim(),
    lastName : $('lastName').value.trim(),
    nickname : $('nickname').value.trim(),
    age      : Number($('age').value),
    grade    : $('grade').value,
    phone    : digits($('phone').value),
    parentName: $('parentName').value.trim()
  };
  const err =
    !p.slotId               ? 'กรุณาเลือกรอบเรียน' :
    !p.firstName            ? 'กรุณากรอกชื่อจริง' :
    !p.lastName             ? 'กรุณากรอกนามสกุล' :
    !p.nickname             ? 'กรุณากรอกชื่อเล่น' :
    !p.age||p.age<3||p.age>20 ? 'อายุต้องอยู่ระหว่าง 3–20 ปี' :
    !p.grade                ? 'กรุณาเลือกระดับชั้น' :
    !validPhone(p.phone)    ? 'เบอร์โทรไม่ถูกต้อง เช่น 081-234-5678' : null;
  if (err) return say($('bookMsg'), err, false);

  $('submitBtn').disabled = true; $('submitBtn').textContent = 'กำลังบันทึก...';
  try{
    const code = await DB.book(p);
    say($('bookMsg'), `จองสำเร็จ! รหัสการจองของคุณคือ ${code} — ทางโรงเรียนจะโทรกลับเพื่อยืนยันครับ`, true);
    ['firstName','lastName','nickname','age','phone','parentName'].forEach(i => $(i).value = '');
    $('grade').value = ''; picked = null;
  }catch(e){ say($('bookMsg'), e.message, false); }
  await loadSlots();
};

async function loadContact(){
  try{
    const c = await DB.settings();
    $('cLabel').textContent = c.contactLabel || 'สอบถามเพิ่มเติม';
    $('cPhone').textContent = c.contactPhone || '—';
    $('cPhone').href = c.contactPhone ? 'tel:'+digits(c.contactPhone) : '#';
    $('cLine').innerHTML = c.lineId ? `LINE: <b style="color:var(--navy)">${esc(c.lineId)}</b>` : '';
    $('cLine').classList.toggle('hide', !c.lineId);
    $('cfgPhone').value = c.contactPhone; $('cfgLabel').value = c.contactLabel; $('cfgLine').value = c.lineId;
  }catch(e){}
}

/* ══════════ ควบคุมหน้าผู้ดูแล ══════════ */
const EMPTY = {id:'',date:'',start_time:'',end_time:'',subject:'Phonics',teacher:'',capacity:6,status:'open',note:''};
let cacheSlots = [], cacheBookings = [];

function fillForm(s){
  $('sId').value=s.id||''; $('sDate').value=s.date||''; $('sStart').value=s.start_time||'';
  $('sEnd').value=s.end_time||''; $('sSubject').value=s.subject||'Phonics';
  $('sTeacher').value=s.teacher||''; $('sCap').value=s.capacity||6;
  $('sStatus').value=s.status||'open'; $('sNote').value=s.note||'';
  const locked = s.id && s.booked > 0;
  $('slotFormTitle').textContent = s.id ? `แก้ไขรอบเรียน #${s.id}` : 'เพิ่มรอบเรียนใหม่';
  $('slotFormHint').textContent  = locked ? `รอบนี้มีผู้จองแล้ว ${s.booked} คน — เปลี่ยนวัน/เวลาไม่ได้` : 'กำหนดวัน เวลา และจำนวนที่นั่ง';
  ['sDate','sStart','sEnd'].forEach(i => $(i).readOnly = !!locked);
}

$('clearSlotBtn').onclick = () => { fillForm(EMPTY); say($('admMsg'),'',true); };

$('saveSlotBtn').onclick = async () => {
  const s = {
    id: $('sId').value ? Number($('sId').value) : null,
    date:$('sDate').value, start_time:$('sStart').value, end_time:$('sEnd').value,
    subject:$('sSubject').value, teacher:$('sTeacher').value.trim(),
    capacity:Number($('sCap').value), status:$('sStatus').value, note:$('sNote').value.trim()
  };
  if(!s.date||!s.start_time||!s.end_time||!s.teacher) return say($('admMsg'),'กรอกวันที่ เวลา และชื่อครูให้ครบ',false);
  if(s.end_time<=s.start_time) return say($('admMsg'),'เวลาสิ้นสุดต้องหลังเวลาเริ่ม',false);
  try{ await DB.saveSlot(s); say($('admMsg'),'บันทึกรอบเรียนเรียบร้อย',true); fillForm(EMPTY); refreshAdmin(); }
  catch(e){ say($('admMsg'), e.message, false); }
};

$('saveCfgBtn').onclick = async () => {
  if(!validPhone($('cfgPhone').value)) return say($('admMsg'),'เบอร์โทรไม่ถูกต้อง เช่น 081-234-5678',false);
  try{
    await DB.saveSettings({contactPhone:$('cfgPhone').value,contactLabel:$('cfgLabel').value.trim(),lineId:$('cfgLine').value.trim()});
    say($('admMsg'),'อัปเดตข้อมูลติดต่อเรียบร้อย',true); loadContact();
  }catch(e){ say($('admMsg'), e.message, false); }
};

async function refreshAdmin(){
  try{
    cacheSlots = await DB.allSlots();
    $('tblSlots').innerHTML =
      '<thead><tr><th>วันที่</th><th>เวลา</th><th>วิชา</th><th>ครู</th><th>จอง/ที่นั่ง</th><th>สถานะ</th><th></th></tr></thead><tbody>' +
      (cacheSlots.length ? cacheSlots.map(s=>`<tr>
        <td>${thaiDate(s.date)}</td><td>${esc(s.start_time)}–${esc(s.end_time)}</td>
        <td>${esc(s.subject)}</td><td>${esc(s.teacher)}</td>
        <td><b>${s.booked}/${s.capacity}</b></td>
        <td><span class="badge${s.status==='open'?'':' off'}">${s.status==='open'?'เปิดรับ':'ปิดรับ'}</span></td>
        <td><button class="lnk" data-edit="${s.id}">แก้ไข</button>${
          s.booked===0?` <button class="lnk red" data-del="${s.id}">ลบ</button>`:''}</td></tr>`).join('')
        : '<tr><td colspan="7" style="color:#8aa3bd">ยังไม่มีรอบเรียน</td></tr>') + '</tbody>';

    $('tblSlots').querySelectorAll('[data-edit]').forEach(b => b.onclick = () => {
      fillForm(cacheSlots.find(s => s.id === Number(b.dataset.edit)));
      window.scrollTo({top:0,behavior:'smooth'});
    });
    $('tblSlots').querySelectorAll('[data-del]').forEach(b => b.onclick = async () => {
      if(!confirm('ลบรอบเรียนนี้?')) return;
      try{ await DB.delSlot(Number(b.dataset.del)); refreshAdmin(); }
      catch(e){ say($('admMsg'), e.message, false); }
    });

    cacheBookings = await DB.allBookings();
    $('bkTitle').textContent = `รายชื่อผู้จอง (${cacheBookings.length})`;
    $('tblBookings').innerHTML =
      '<thead><tr><th>รหัส</th><th>วันเรียน</th><th>เวลา</th><th>ชื่อ-สกุล</th><th>ชื่อเล่น</th><th>อายุ</th><th>ชั้น</th><th>เบอร์โทร</th><th>ผู้ปกครอง</th><th></th></tr></thead><tbody>' +
      (cacheBookings.length ? cacheBookings.map(b=>`<tr>
        <td>B${String(b.id).padStart(4,'0')}</td>
        <td>${b.date?thaiDate(b.date):'-'}</td>
        <td>${esc(b.start_time)}–${esc(b.end_time)}</td>
        <td>${esc(b.first_name)} ${esc(b.last_name)}</td>
        <td>${esc(b.nickname)}</td><td>${b.age}</td><td>${esc(b.grade)}</td>
        <td><a href="tel:${digits(b.phone)}">${fmtPhone(b.phone)}</a></td>
        <td>${esc(b.parent_name)}</td>
        <td><button class="lnk red" data-cancel="${b.id}">ยกเลิก</button></td></tr>`).join('')
        : '<tr><td colspan="10" style="color:#8aa3bd">ยังไม่มีผู้จอง</td></tr>') + '</tbody>';

    $('tblBookings').querySelectorAll('[data-cancel]').forEach(b => b.onclick = async () => {
      if(!confirm('ยกเลิกการจองรายการนี้?')) return;
      await DB.cancelBooking(Number(b.dataset.cancel)); refreshAdmin();
    });
  }catch(e){ say($('admMsg'),'โหลดข้อมูลไม่สำเร็จ: '+e.message,false); }
}

$('csvBtn').onclick = () => {
  const head = ['รหัสการจอง','วันที่เรียน','เวลา','วิชา','ชื่อจริง','นามสกุล','ชื่อเล่น','อายุ','ระดับชั้น','เบอร์โทรติดต่อ','ชื่อผู้ปกครอง','วันที่จอง'];
  const q = v => `"${String(v ?? '').replace(/"/g,'""')}"`;
  const rows = cacheBookings.map(b => [
    'B'+String(b.id).padStart(4,'0'), b.date, `${b.start_time}-${b.end_time}`, b.subject,
    b.first_name, b.last_name, b.nickname, b.age, b.grade, fmtPhone(b.phone), b.parent_name,
    new Date(b.created_at).toLocaleString('th-TH',{timeZone:'Asia/Bangkok'})
  ].map(q).join(','));
  const blob = new Blob(['\uFEFF'+[head.join(','),...rows].join('\n')],{type:'text/csv;charset=utf-8'});
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = `bookings-${new Date().toISOString().slice(0,10)}.csv`;
  a.click(); URL.revokeObjectURL(a.href);
};

$('loginBtn').onclick = async () => {
  try{
    await DB.login('', $('admPass').value);
    $('admPass').value=''; route();
  }catch(e){ say($('loginMsg'), e.message, false); }
};
$('admPass').addEventListener('keydown', e => e.key === 'Enter' && $('loginBtn').click());
$('logoutBtn').onclick = async () => { await DB.logout(); location.hash = ''; };

async function route(){
  const isAdmin = location.hash === '#admin';
  $('pageBook').classList.toggle('hide', isAdmin);
  $('pageAdmin').classList.toggle('hide', !isAdmin);
  window.scrollTo(0,0);
  if (!isAdmin) { loadSlots(); loadContact(); return; }
  const authed = await DB.isAdmin();
  $('loginView').classList.toggle('hide', authed);
  $('adminView').classList.toggle('hide', !authed);
  if (authed) { await loadContact(); fillForm(EMPTY); refreshAdmin(); }
}
window.addEventListener('hashchange', route);
route();
</script>
</body>
</html>
