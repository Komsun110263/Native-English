        <label><span>ชื่อเล่น *</span><input id="nickname" autocomplete="off"></label>
        <label><span>อายุ (ปี) *</span><input id="age" type="number" min="3" max="20" inputmode="numeric"></label>
        <label class="full"><span>กำลังเรียนชั้น *</span>
          <select id="grade">
            <option value="">— เลือกระดับชั้น —</option>
            <optgroup label="อนุบาล"><option>อ.1</option><option>อ.2</option><option>อ.3</option></optgroup>
            <optgroup label="ประถม"><option>ป.1</option><option>ป.2</option><option>ป.3</option><option>ป.4</option><option>ป.5</option><option>ป.6</option></optgroup>
            <optgroup label="มัธยม"><option>ม.1</option><option>ม.2</option><option>ม.3</option><option>ม.4</option><option>ม.5</option><option>ม.6</option></optgroup>
          </select>
