        <label><span>เบอร์โทรติดต่อ *</span>
          <input id="phone" type="tel" inputmode="numeric" maxlength="12" placeholder="081-234-5678"></label>
        <label><span>ชื่อผู้ปกครอง</span><input id="parentName" autocomplete="off"></label>
      </div>
