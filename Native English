      <div id="bookMsg"></div>
    </section>

    <!-- เบอร์โทรด้านล่าง เปลี่ยนได้จากหน้าผู้ดูแล -->
    <section class="card contact">
      <div class="lb" id="cLabel">สอบถามเพิ่มเติม</div>
      <a class="ph" id="cPhone" href="#">—</a>
      <div class="line hide" id="cLine"></div>
    </section>

    <p class="foot">Native English@Libda • บางกรวย นนทบุรี • <a href="#admin">สำหรับครู</a></p>
  </div>
</div>

<!-- ══════════ หน้าผู้ดูแล ══════════ -->
<div id="pageAdmin" class="hide">
  <div id="loginView" class="center">
    <div class="card" style="width:100%;max-width:380px">
      <h2 style="justify-content:center;margin-bottom:16px">เข้าสู่ระบบผู้ดูแล</h2>
      <label><span>รหัสผ่าน</span><input id="admPass" type="password" autocomplete="current-password"></label>
      <button class="btn" id="loginBtn">เข้าสู่ระบบ</button>
      <div id="loginMsg"></div>
      <p class="foot"><a href="#">← กลับหน้าจอง</a></p>
    </div>
  </div>

  <div id="adminView" class="hide">
